<?xml version="1.0" encoding="UTF-8"?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence/orm https://jakarta.ee/xml/ns/persistence/orm/orm_3_1.xsd"
	version="3.1">

	<persistence-unit-metadata>
		<persistence-unit-defaults>
			<access>FIELD</access>
			<entity-listeners>
				<entity-listener class="uo.ri.cws.infrastructure.persistence.jpa.util.EntityListener" />
			</entity-listeners>
		</persistence-unit-defaults>
	</persistence-unit-metadata>

	<access>FIELD</access>

<!--  Vehicle queries  -->
	<named-query name="Vehicle.findByPlate">
		<query>select v from Vehicle v where v.licensePlate = ?1</query>
	</named-query>
	
	<!--  WorkOrder queries  -->
	<named-query name="WorkOrder.findByIds">
		<query>select w from WorkOrder w where w.id in ?1</query>
	</named-query>

	<named-query name="WorkOrder.findNotInvoicedByClientNif">
		<query>
			select w 
			from WorkOrder w 
			where w.vehicle.client.nif = ?1 
			  and w.state = uo.ri.cws.domain.WorkOrder.WorkOrderState.APPROVED
		</query>
	</named-query>
	
	<!--  PaymentMean queries  -->
	<named-query name="PaymentMean.findByInvoiceId">
		<query>
			select m 
			from Invoice f 
				join f.workOrders w 
				join w.vehicle.client c 
				join c.paymentMeans m 
			where f.id = ?1
		</query>
	</named-query>

	<named-query name="PaymentMean.findByClientNif">
		<query>select pm from PaymentMean pm where pm.client.nif = ?1</query>
	</named-query>

	<named-query name="PaymentMean.findVouchersByClientNif">
		<query>select v from Voucher v where v.client.nif = ?1</query>
	</named-query>

	<named-query name="PaymentMean.findVoucherByCode">
		<query>select v from Voucher v where v.code = ?1</query>
	</named-query>

	<named-query name="PaymentMean.findCreditCardByNumber">
		<query>select c from CreditCard c where c.number = ?1</query>
	</named-query>

	<named-query name="PaymentMean.findByIds">
		<query>select pm from PaymentMean pm where pm.id in ?1</query>
	</named-query>

	<named-query name="PaymentMean.countCharges">
		<query>select count(c) from Charge c where c.paymentMean.id = ?1</query>
	</named-query>

	<!--  Voucher queries  -->
	<named-query name="Voucher.summary">
		<query>
			select v.client.nif.nif, v.client.fullName.name, v.client.fullName.surname, 
			       count(v), 
			       sum(v.accumulated.amount), 
			       sum(v.availableAmount.amount)
			from Voucher v
			group by v.client.nif.nif, v.client.fullName.name, v.client.fullName.surname
			order by sum(v.availableAmount.amount) desc
		</query>
	</named-query>
	
	<!--  Mechanic queries  -->
	<named-query name="Mechanic.findByNif">
		<query> select m from Mechanic m where m.nif = ?1 </query>
	</named-query>

	<named-query name="Mechanic.countInterventions">
		<query>select count(i) from Intervention i where i.mechanic.id = ?1</query>
	</named-query>
	
	<!--  Invoice queries  -->
	<named-query name="Invoice.findByNumber">
		<query>select f from Invoice f where f.number = ?1</query>
	</named-query>

	<named-query name="Invoice.findOverAmountUnusedForVoucher">
		<query>
			<![CDATA[
			select i 
			from Invoice i 
			where i.total.amount > ?1 
			  and i.usedForVoucher = false 
			  and i.state = uo.ri.cws.domain.Invoice.InvoiceState.PAID
			]]>
		</query>
	</named-query>
	
	<named-query name="Invoice.getNextInvoiceNumber">
		<query> 
			select cast( coalesce(max(f.number) + 1, 1L) as bigint ) 
			from Invoice f 
		</query>
	</named-query>

	<!--  Client queries  -->
	<named-query name="Client.findByNif">
		<query>select c from Client c where c.nif = ?1</query>
	</named-query>

	<named-query name="Client.findRecommendedBy">
		<query>select r.recommended from Recommendation r where r.recommender.nif = ?1</query>
	</named-query>

	<named-query name="Client.findWithWorkOrdersUnusedForVoucher">
		<query>
			select distinct c from Client c join c.vehicles v join v.workOrders wo
			where wo.usedForVoucher = false and wo.state = uo.ri.cws.domain.WorkOrder.WorkOrderState.INVOICED
			group by c
			having count(wo) >= ?1
		</query>
	</named-query>

	<named-query name="Client.findWithRecommendationsUnusedForVoucher">
		<query>
			select distinct c from Client c join c.recommendations r
			where r.usedForVoucher = false
			group by c
			having count(r) >= ?1
		</query>
	</named-query>

	<named-query name="Client.hasPaidInvoices">
		<query>
			select count(distinct i)
			from Invoice i 
			  join i.workOrders wo 
			  join wo.vehicle v 
			  join v.client c 
			where c.id = ?1 
			  and i.state = uo.ri.cws.domain.Invoice.InvoiceState.PAID
		</query>
	</named-query>

	<!-- ==================================================================== -->
	<!-- Mapped Superclass                                                    -->
	<!-- ==================================================================== -->
	<mapped-superclass class="uo.ri.cws.domain.base.BaseEntity">
		<pre-update method-name="preUpdate" />
		<attributes>
			<id name="id">
				<column name="ID" />
			</id>
			<basic name="createdAt">
				<column name="CREATEDAT" />
			</basic>
			<basic name="updatedAt">
				<column name="UPDATEDAT" />
			</basic>
			<basic name="entityState">
				<column name="ENTITYSTATE" />
				<enumerated>STRING</enumerated>
			</basic>
			<version name="version">
				<column name="VERSION" />
			</version>
		</attributes>
	</mapped-superclass>

	<!-- ==================================================================== -->
	<!-- Entities                                                             -->
	<!-- ==================================================================== -->
	<entity class="uo.ri.cws.domain.Cash">
		<table name="TCASHES" />
		<discriminator-value>Cash</discriminator-value>
		<attributes />
	</entity>

	<entity class="uo.ri.cws.domain.Charge">
		<table name="TCHARGES">
			<unique-constraint>
				<column-name>INVOICE_ID</column-name>
				<column-name>PAYMENTMEAN_ID</column-name>
			</unique-constraint>
		</table>
		<attributes>
			<many-to-one name="invoice">
				<join-column name="INVOICE_ID" />
			</many-to-one>
			<many-to-one name="paymentMean">
				<join-column name="PAYMENTMEAN_ID" />
			</many-to-one>
			<embedded name="amount">
				<attribute-override name="amount">
					<column name="CHARGE" precision="19" scale="2" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.Client">
		<table name="TCLIENTS" />
		<attributes>
			<one-to-many name="vehicles" mapped-by="client" />
			<one-to-many name="paymentMeans" mapped-by="client" />
			<one-to-many name="recommendations" mapped-by="recommender" />
			<one-to-one name="recommendation" mapped-by="recommended" />
			<embedded name="nif">
				<attribute-override name="nif">
					<column name="NIF" unique="true" />
				</attribute-override>
			</embedded>
			<embedded name="fullName">
				<attribute-override name="name">
					<column name="NAME" />
				</attribute-override>
				<attribute-override name="surname">
					<column name="SURNAME" />
				</attribute-override>
			</embedded>
			<embedded name="email">
				<attribute-override name="email">
					<column name="EMAIL" />
				</attribute-override>
			</embedded>
			<embedded name="phone">
				<attribute-override name="phone">
					<column name="PHONE" />
				</attribute-override>
			</embedded>
			<embedded name="address">
				<attribute-override name="street">
					<column name="STREET" />
				</attribute-override>
				<attribute-override name="city">
					<column name="CITY" />
				</attribute-override>
				<attribute-override name="country">
					<column name="COUNTRY" />
				</attribute-override>
				<attribute-override name="postalCode">
					<column name="POSTALCODE" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.CreditCard">
		<table name="TCREDITCARDS" />
		<discriminator-value>CreditCard</discriminator-value>
		<attributes>
			<basic name="type">
				<column name="TYPE" />
			</basic>
			<basic name="validThru">
				<column name="VALIDTHRU" />
			</basic>
			<embedded name="number">
				<attribute-override name="number">
					<column name="NUMBER" unique="true" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.Intervention">
		<table name="TINTERVENTIONS">
			<unique-constraint>
				<column-name>MECHANIC_ID</column-name>
				<column-name>WORKORDER_ID</column-name>
				<column-name>DATE</column-name>
			</unique-constraint>
		</table>
		<attributes>
			<basic name="date">
				<column name="DATE" />
			</basic>
			<basic name="minutes">
				<column name="MINUTES" />
			</basic>
			<many-to-one name="workOrder">
				<join-column name="WORKORDER_ID" />
			</many-to-one>
			<many-to-one name="mechanic">
				<join-column name="MECHANIC_ID" />
			</many-to-one>
			<one-to-many name="substitutions" mapped-by="intervention" orphan-removal="true">
				<cascade>
					<cascade-all />
				</cascade>
			</one-to-many>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.Invoice">
		<table name="TINVOICES" />
		<attributes>
			<basic name="number">
				<column name="NUMBER" unique="true" />
			</basic>
			<basic name="date">
				<column name="DATE" />
			</basic>
			<basic name="state">
				<column name="STATE" />
				<enumerated>STRING</enumerated>
			</basic>
			<basic name="usedForVoucher">
				<column name="USEDFORVOUCHER" />
			</basic>
			<one-to-many name="workOrders" mapped-by="invoice" />
			<one-to-many name="charges" mapped-by="invoice" orphan-removal="true">
				<cascade>
					<cascade-all />
				</cascade>
			</one-to-many>
			<embedded name="subtotal">
				<attribute-override name="amount">
					<column name="SUBTOTAL" precision="19" scale="2" />
				</attribute-override>
			</embedded>
			<embedded name="vatRate">
				<attribute-override name="value">
					<column name="VATRATE" />
				</attribute-override>
			</embedded>
			<embedded name="vatAmount">
				<attribute-override name="amount">
					<column name="VATAMOUNT" precision="19" scale="2" />
				</attribute-override>
			</embedded>
			<embedded name="total">
				<attribute-override name="amount">
					<column name="TOTAL" precision="19" scale="2" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.Mechanic">
		<table name="TMECHANICS" />
		<attributes>
			<one-to-many name="assigned" mapped-by="mechanic" />
			<embedded name="nif">
				<attribute-override name="nif">
					<column name="NIF" unique="true" />
				</attribute-override>
			</embedded>
			<embedded name="fullName">
				<attribute-override name="name">
					<column name="NAME" />
				</attribute-override>
				<attribute-override name="surname">
					<column name="SURNAME" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.PaymentMean">
		<table name="TPAYMENTMEANS" />
		<inheritance strategy="JOINED" />
		<attributes>
			<many-to-one name="client">
				<join-column name="CLIENT_ID" />
			</many-to-one>
			<embedded name="accumulated">
				<attribute-override name="amount">
					<column name="ACCUMULATED" precision="19" scale="2" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.Recommendation">
		<table name="TRECOMMENDATIONS">
			<unique-constraint>
				<column-name>RECOMMENDER_ID</column-name>
				<column-name>RECOMMENDED_ID</column-name>
			</unique-constraint>
		</table>
		<attributes>
			<basic name="usedForVoucher">
				<column name="USEDFORVOUCHER" />
			</basic>
			<many-to-one name="recommender">
				<join-column name="RECOMMENDER_ID" />
			</many-to-one>
			<one-to-one name="recommended">
				<join-column name="RECOMMENDED_ID" unique="true" />
			</one-to-one>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.SparePart">
		<table name="TSPAREPARTS" />
		<attributes>
			<basic name="code">
				<column name="CODE" unique="true" />
			</basic>
			<basic name="description">
				<column name="DESCRIPTION" />
			</basic>
			<embedded name="unitPrice">
				<attribute-override name="amount">
					<column name="PRICE" precision="19" scale="2" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.Substitution">
		<table name="TSUBSTITUTIONS">
			<unique-constraint>
				<column-name>INTERVENTION_ID</column-name>
				<column-name>SPAREPART_ID</column-name>
			</unique-constraint>
		</table>
		<attributes>
			<basic name="quantity">
				<column name="QUANTITY" />
			</basic>
			<many-to-one name="sparePart">
				<join-column name="SPAREPART_ID" />
			</many-to-one>
			<many-to-one name="intervention">
				<join-column name="INTERVENTION_ID" />
			</many-to-one>
			<embedded name="price">
				<attribute-override name="amount">
					<column name="PRICE" precision="19" scale="2" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.Vehicle">
		<table name="TVEHICLES" />
		<attributes>
			<basic name="make">
				<column name="MAKE" />
			</basic>
			<basic name="model">
				<column name="MODEL" />
			</basic>
			<many-to-one name="vehicleType">
				<join-column name="VEHICLETYPE_ID" />
			</many-to-one>
			<many-to-one name="client">
				<join-column name="CLIENT_ID" />
			</many-to-one>
			<one-to-many name="workOrders" mapped-by="vehicle" />
			<embedded name="licensePlate">
				<attribute-override name="licensePlate">
					<column name="LICENSEPLATE" unique="true" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.VehicleType">
		<table name="TVEHICLETYPES" />
		<attributes>
			<basic name="name">
				<column name="NAME" unique="true" />
			</basic>
			<one-to-many name="vehicles" mapped-by="vehicleType" />
			<embedded name="pricePerHour">
				<attribute-override name="amount">
					<column name="PRICE_PER_HOUR" precision="19" scale="2" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.Voucher">
		<table name="TVOUCHERS" />
		<discriminator-value>Voucher</discriminator-value>
		<attributes>
			<basic name="description">
				<column name="DESCRIPTION" />
			</basic>
			<embedded name="code">
				<attribute-override name="code">
					<column name="CODE" unique="true" />
				</attribute-override>
			</embedded>
			<embedded name="availableAmount">
				<attribute-override name="amount">
					<column name="AVAILABLE" precision="19" scale="2" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<entity class="uo.ri.cws.domain.WorkOrder">
		<table name="TWORKORDERS">
			<unique-constraint>
				<column-name>VEHICLE_ID</column-name>
				<column-name>DATE</column-name>
			</unique-constraint>
		</table>
		<attributes>
			<basic name="date">
				<column name="DATE" />
			</basic>
			<basic name="description">
				<column name="DESCRIPTION" />
			</basic>
			<basic name="state">
				<column name="STATE" />
				<enumerated>STRING</enumerated>
			</basic>
			<basic name="usedForVoucher">
				<column name="USEDFORVOUCHER" />
			</basic>
			<many-to-one name="invoice">
				<join-column name="INVOICE_ID" />
			</many-to-one>
			<many-to-one name="mechanic">
				<join-column name="MECHANIC_ID" />
			</many-to-one>
			<many-to-one name="vehicle">
				<join-column name="VEHICLE_ID" />
			</many-to-one>
			<one-to-many name="interventions" mapped-by="workOrder" orphan-removal="true">
				<cascade>
					<cascade-all />
				</cascade>
			</one-to-many>
			<embedded name="amount">
				<attribute-override name="amount">
					<column name="TOTAL_AMOUNT" precision="19" scale="2" />
				</attribute-override>
			</embedded>
		</attributes>
	</entity>

	<!-- ==================================================================== -->
	<!-- Embeddables                                                          -->
	<!-- ==================================================================== -->
	<embeddable class="uo.ri.cws.domain.types.Address">
		<attributes>
			<basic name="street" />
			<basic name="city" />
			<basic name="country" />
			<basic name="postalCode" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.CreditCardNumber">
		<attributes>
			<basic name="number" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.Email">
		<attributes>
			<basic name="email" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.FullName">
		<attributes>
			<basic name="name" />
			<basic name="surname" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.LicensePlate">
		<attributes>
			<basic name="licensePlate" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.Money">
		<attributes>
			<basic name="amount" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.Nif">
		<attributes>
			<basic name="nif" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.Percentage">
		<attributes>
			<basic name="value" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.PhoneNumber">
		<attributes>
			<basic name="phone" />
		</attributes>
	</embeddable>

	<embeddable class="uo.ri.cws.domain.types.VoucherCode">
		<attributes>
			<basic name="code" />
		</attributes>
	</embeddable>

</entity-mappings>
